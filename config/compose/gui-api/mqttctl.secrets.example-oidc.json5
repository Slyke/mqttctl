{
  // Used to sign app-owned session cookies.
  sessionSecret: 'change-me-local-session-secret-please',

  // Keep provider secrets out of the main config file.
  oidcClientSecret: 'change-me-oidc-client-secret',

  broker: {
    dynsecAdminPassword: 'change-me-compose-dynsec',
    // Must match auth.apiKey in config/compose/mqtt-agent/broker-agent.config.json.
    agentApiKey: 'change-me-compose-broker-agent',
  },
}
