{
  "name": "mqttctl-mcp",
  "version": "0.0.8",
  "description": "Stateful MCP server for the mqttctl HTTP API.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "keygen": "node scripts/generate-signing-keypair.mjs",
    "build-info": "node scripts/write-build-info.mjs",
    "test": "node --test",
    "check": "node --check src/index.js && node scripts/error-gen.mjs --action validate && node --test",
    "error-add": "node scripts/error-gen.mjs --action add",
    "error-delete": "node scripts/error-gen.mjs --action delete",
    "error-validate": "node scripts/error-gen.mjs --action validate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "json5": "^2.2.3",
    "undici": "^8.11.2",
    "zod": "^4.6.6"
  }
}
