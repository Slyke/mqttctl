{
  "name": "mqttctl-fe",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "dependencies": {
    "argon2": "0.44.0",
    "better-sqlite3": "12.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.65.1",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@types/node": "25.5.0",
    "svelte": "5.56.3",
    "svelte-check": "4.4.6",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  },
  "scripts": {
    "start": "node build",
    "dev": "vite dev",
    "prebuild": "node ../scripts/write-build-info.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "TMPDIR=/tmp TMP=/tmp TEMP=/tmp vitest run --config ./vitest.config.ts --configLoader runner",
    "error-add": "node ../../err_gen.js --action add --error-file ./src/errors.json",
    "error-delete": "node ../../err_gen.js --action delete --error-file ./src/errors.json",
    "error-rm": "node ../../err_gen.js --action delete --error-file ./src/errors.json",
    "error-validate": "node ../../err_gen.js --action validate --error-file ./src/errors.json",
    "error-get": "node ../../err_gen.js --action get --error-file ./src/errors.json",
    "error-search": "node ../../err_gen.js --action search --error-file ./src/errors.json",
    "error-all": "node ../../err_gen.js --action all --error-file ./src/errors.json"
  }
}
